static void parse_byte(uint8_t b)
{
  switch (g_rx_state)
  {
    case 0:
      if (b == 0xAA) g_rx_state = 1;
      break;
    case 1:
      if (b == 0x55) { g_rx_state = 2; g_rx_idx = 0; }
      else if (b == 0xAA) { g_rx_state = 1; }
      else { g_rx_state = 0; }
      break;
    case 2:
      g_rx_data[g_rx_idx++] = b;
      if (g_rx_idx >= 4) g_rx_state = 3;
      break;
    case 3:
    {
      uint8_t ck = g_rx_data[0] ^ g_rx_data[1] ^ g_rx_data[2] ^ g_rx_data[3];
      if (b == ck)
      {
        g_err_x = (int16_t)((uint16_t)g_rx_data[0] | ((uint16_t)g_rx_data[1] << 8));
        g_err_y = (int16_t)((uint16_t)g_rx_data[2] | ((uint16_t)g_rx_data[3] << 8));
        g_frame_ready = 1;
      }
      g_rx_state = 0;
      break;
    }
    default:
      g_rx_state = 0;
      break;
  }
}

static void set_servo_pulse(void)
{
  g_lr_us = CLAMP(g_lr_us, PAN_MIN_US,  PAN_MAX_US);
  g_ud_us = CLAMP(g_ud_us, TILT_MIN_US, TILT_MAX_US);
  g_lr_us = CLAMP(g_lr_us, PULSE_MIN_US, PULSE_MAX_US);
  g_ud_us = CLAMP(g_ud_us, PULSE_MIN_US, PULSE_MAX_US);

  __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, (uint32_t)g_ud_us);  /* PA0 = ???? */
  __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, (uint32_t)g_lr_us);  /* PA1 = ???? */
}

static void laser_on(void)
{
  __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, LASER_ON_US);   /* PB0 ?? 2000us */
}

static void laser_off(void)
{
  __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, LASER_OFF_US);  /* PB0 ?? 1000us */
}

static void process_frame(int16_t ex, int16_t ey)
{
  int32_t dx = 0;
  int32_t dy = 0;

  if (ex > DEADZONE_PX || ex < -DEADZONE_PX)
    dx = (int32_t)(KP_X * ex * DIR_X);
  if (ey > DEADZONE_PX || ey < -DEADZONE_PX)
    dy = (int32_t)(KP_Y * ey * DIR_Y);

  dx = CLAMP(dx, -MAX_STEP_US, MAX_STEP_US);
  dy = CLAMP(dy, -MAX_STEP_US, MAX_STEP_US);

  g_lr_us += dx;
  g_ud_us += dy;

  set_servo_pulse();
}

