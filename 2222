int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART1_UART_Init();

  /* USER CODE BEGIN 2 */
  MX_TIM2_Init();
  MX_TIM3_Init();
  set_servo_pulse();
  laser_off();                       /* ????? */

  uint8_t rx_byte = 0;
  uint32_t last_frame_ms = 0;
  uint8_t servo_active = 0;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    if (!servo_active && HAL_GetTick() >= STARTUP_DELAY_MS)
    {
      servo_active = 1;
      last_frame_ms = HAL_GetTick();
    }

    if (HAL_UART_Receive(&huart1, &rx_byte, 1, 5) == HAL_OK)
    {
      parse_byte(rx_byte);
    }

    if (g_frame_ready)
    {
      g_frame_ready = 0;
      last_frame_ms = HAL_GetTick();
      if (servo_active && (HAL_GetTick() - last_control_ms) >= MIN_CONTROL_INTERVAL_MS)
      {
        last_control_ms = HAL_GetTick();
        process_frame(g_err_x, g_err_y);
      }
    }

    if (servo_active && (HAL_GetTick() - last_frame_ms) > TIMEOUT_MS)
    {
      /* ???? */
    }

    /* ===== ????:??????? ===== */
    if (servo_active &&
        (HAL_GetTick() - last_frame_ms) < TIMEOUT_MS &&
        g_err_x >= -CENTER_THRESHOLD && g_err_x <= CENTER_THRESHOLD &&
        g_err_y >= -CENTER_THRESHOLD && g_err_y <= CENTER_THRESHOLD)
    {
      if (centered_since == 0)
      {
        centered_since = HAL_GetTick();
      }
      if (HAL_GetTick() - centered_since >= CENTER_HOLD_MS)
      {
        laser_on();                 /* ???? */
      }
    }
    else
    {
      centered_since = 0;
      laser_off();                  /* ??? */
    }
    /* ===== ?????? ===== */
    /* USER CODE END 3 */
  }
}

